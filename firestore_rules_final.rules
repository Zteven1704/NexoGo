rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regla general: usuarios autenticados pueden leer/escribir
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Reglas específicas para colecciones de NexoGo
    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null; // Otros usuarios pueden leer perfiles
    }
    
    match /citas/{appointmentId} {
      allow read, write: if request.auth != null;
    }
    
    match /inventario/{productId} {
      allow read, write: if request.auth != null;
    }
    
    match /patients/{patientId} {
      allow read, write: if request.auth != null;
    }
    
    match /clinical_records/{recordId} {
      allow read, write: if request.auth != null;
    }
    
    match /sales/{saleId} {
      allow read, write: if request.auth != null;
    }
    
    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }
    
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
    }
    
    match /diagnostics/{docId} {
      allow read, write: if request.auth != null;
    }
    
    match /test/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}

