rules_version = '2';

/**
 * NexoGo Firestore rules — S0 Secure
 * Deny by default. Tenant data under companies/{companyId} requires ACTIVE membership.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function membershipPath(companyId) {
      return /databases/$(database)/documents/companies/$(companyId)/memberships/$(request.auth.uid);
    }

    function isCompanyMember(companyId) {
      return isSignedIn()
        && exists(membershipPath(companyId))
        && get(membershipPath(companyId)).data.status == 'ACTIVE';
    }

    function membershipRoleCodes(companyId) {
      return get(membershipPath(companyId)).data.roleCodes;
    }

    /** ACTIVE member with ADMIN or SUPER_ADMIN in roleCodes. */
    function isCompanyAdmin(companyId) {
      return isCompanyMember(companyId)
        && (
          'ADMIN' in membershipRoleCodes(companyId)
          || 'SUPER_ADMIN' in membershipRoleCodes(companyId)
        );
    }

    function companyDoc(companyId) {
      return /databases/$(database)/documents/companies/$(companyId);
    }

    /**
     * CASO 1 — Bootstrap: caller creates own ACTIVE membership on a company
     * they own (createdBy == uid). Supports same-batch create via existsAfter/getAfter.
     * Only the first owner path: roleCodes must include ADMIN.
     */
    function isBootstrapMembershipCreate(companyId, userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasAll(['userId', 'companyId', 'status', 'roleCodes'])
        && request.resource.data.userId == userId
        && request.resource.data.companyId == companyId
        && request.resource.data.status == 'ACTIVE'
        && 'ADMIN' in request.resource.data.roleCodes
        && (
          (exists(companyDoc(companyId))
            && get(companyDoc(companyId)).data.createdBy == request.auth.uid)
          || (existsAfter(companyDoc(companyId))
            && getAfter(companyDoc(companyId)).data.createdBy == request.auth.uid)
        );
    }

    function inviteDoc(inviteId) {
      return /databases/$(database)/documents/company_invites/$(inviteId);
    }

    /**
     * CASO 2 — Invitee create: PENDING invite for same company + Auth email.
     * Requires membership.inviteId → company_invites/{inviteId}.
     */
    function hasValidPendingInvite(companyId) {
      return request.auth.token.email != null
        && request.resource.data.keys().hasAny(['inviteId'])
        && request.resource.data.inviteId is string
        && request.resource.data.inviteId.size() > 0
        && exists(inviteDoc(request.resource.data.inviteId))
        && get(inviteDoc(request.resource.data.inviteId)).data.status == 'PENDING'
        && get(inviteDoc(request.resource.data.inviteId)).data.companyId == companyId
        && get(inviteDoc(request.resource.data.inviteId)).data.email
            == request.auth.token.email.lower();
    }

    function isInviteAcceptanceCreate(companyId, userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasAll(['userId', 'companyId', 'status', 'inviteId'])
        && request.resource.data.userId == userId
        && request.resource.data.companyId == companyId
        && request.resource.data.status == 'ACTIVE'
        && hasValidPendingInvite(companyId);
    }

    /**
     * CASO 3 — Company ADMIN creates a membership for any userId under this company.
     */
    function isAdminMembershipCreate(companyId, userId) {
      return isCompanyAdmin(companyId)
        && request.resource.data.keys().hasAll(['userId', 'companyId', 'status'])
        && request.resource.data.companyId == companyId
        && request.resource.data.userId == userId;
    }

    /** Immutable identity fields on membership update. */
    function membershipIdentityUnchanged(companyId, userId) {
      return request.resource.data.companyId == companyId
        && request.resource.data.userId == userId
        && resource.data.companyId == companyId
        && resource.data.userId == userId;
    }

    /**
     * Invitee may activate only from INVITED/PENDING → ACTIVE.
     * Prefer valid inviteId; admin-stubbed INVITED/PENDING (no invite) also allowed.
     */
    function isInviteeActivationUpdate(companyId, userId) {
      return isOwner(userId)
        && membershipIdentityUnchanged(companyId, userId)
        && resource.data.status in ['INVITED', 'PENDING']
        && request.resource.data.status == 'ACTIVE'
        && (
          hasValidPendingInvite(companyId)
          || !(request.resource.data.keys().hasAny(['inviteId'])
               && request.resource.data.inviteId is string
               && request.resource.data.inviteId.size() > 0)
        );
    }

    /** Owner may edit own ACTIVE profile fields but cannot escalate roleCodes. */
    function isOwnerActiveSelfUpdate(companyId, userId) {
      return isOwner(userId)
        && membershipIdentityUnchanged(companyId, userId)
        && resource.data.status == 'ACTIVE'
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.roleCodes == resource.data.roleCodes;
    }

    function isAdminMembershipUpdate(companyId, userId) {
      return isCompanyAdmin(companyId)
        && membershipIdentityUnchanged(companyId, userId);
    }

    function legacyRole() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
    }

    function isLegacyStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && legacyRole() in ['ADMIN', 'VET', 'VET_ASSISTANT', 'ASSISTANT'];
    }

    function isLegacyAdminOrVet() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && legacyRole() in ['ADMIN', 'VET'];
    }

    // ─── Platform: companies (tenant) ─────────────────────────────────────

    match /companies/{companyId} {
      // Creator must own createdBy — closes forged ownership for FR-01 bootstrap
      allow create: if isSignedIn()
        && request.resource.data.id == companyId
        && request.resource.data.createdBy == request.auth.uid;
      allow read, update: if isCompanyMember(companyId);
      allow delete: if false;

      match /memberships/{userId} {
        allow read: if isOwner(userId) || isCompanyMember(companyId);
        // FR-01: no self-join arbitrario. Solo bootstrap | invite PENDING | ADMIN.
        allow create: if isSignedIn()
          && (
            isBootstrapMembershipCreate(companyId, userId)
            || isInviteAcceptanceCreate(companyId, userId)
            || isAdminMembershipCreate(companyId, userId)
          );
        // FR-01 harden: no EMPLOYEE manage-all; no self role escalation
        allow update: if isAdminMembershipUpdate(companyId, userId)
          || isInviteeActivationUpdate(companyId, userId)
          || isOwnerActiveSelfUpdate(companyId, userId);
        allow delete: if false;
      }

      match /settings/{docId} {
        allow read: if isCompanyMember(companyId);
        allow create: if isSignedIn();
        allow update: if isCompanyMember(companyId);
        allow delete: if false;
      }

      // Tenant collections (clients, records, documents, …).
      // Exclude memberships/settings — they have dedicated rules above (FR-01).
      match /{subcollection}/{docId} {
        allow read, write: if isCompanyMember(companyId)
          && !(subcollection in ['memberships', 'settings']);

        match /{nested=**} {
          allow read, write: if isCompanyMember(companyId)
            && !(subcollection in ['memberships', 'settings']);
        }
      }
    }

    match /company_index/{companyId} {
      allow create: if isSignedIn()
        && request.resource.data.companyId == companyId;
      allow read, update: if isCompanyMember(companyId);
      allow delete: if false;
    }

    // ─── Company invites (discoverable by invitee email before membership) ─
    match /company_invites/{inviteId} {
      // Solo ADMIN crea invites (reduce superficie FR-01)
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['companyId', 'email', 'status'])
        && isCompanyAdmin(request.resource.data.companyId)
        && request.resource.data.status == 'PENDING'
        && request.resource.data.email == request.resource.data.email.lower();
      allow read: if isSignedIn() && (
        isCompanyMember(resource.data.companyId)
        || (request.auth.token.email != null
            && resource.data.email == request.auth.token.email.lower())
      );
      // Invitee solo puede PENDING → ACCEPTED (no reabrir a PENDING)
      allow update: if isSignedIn() && (
        isCompanyAdmin(resource.data.companyId)
        || (request.auth.token.email != null
            && resource.data.email == request.auth.token.email.lower()
            && resource.data.status == 'PENDING'
            && request.resource.data.status == 'ACCEPTED'
            && request.resource.data.companyId == resource.data.companyId
            && request.resource.data.email == resource.data.email
            && request.resource.data.acceptedByUserId == request.auth.uid)
      );
      allow delete: if false;
    }

    // ─── Users + membership mirror ────────────────────────────────────────

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /company_memberships/{companyId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /usuarios/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ─── Platform IAM catalog (client read-only; seed via Admin SDK / console) ─

    match /permissions_catalog/{key} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /platform_roles/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /role_permissions/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /platform/{docId} {
      allow read, write: if false;

      match /audit_logs/{eventId} {
        allow create: if isSignedIn();
        allow read: if false;
        allow update, delete: if false;
      }
    }

    // ─── Legacy root collections (authenticated staff / owner; no catch-all) ─

    match /patients/{patientId} {
      allow read, write: if isLegacyStaff();
    }

    match /appointments/{appointmentId} {
      allow read, write: if isLegacyStaff();
    }

    match /citas/{appointmentId} {
      allow read, write: if isLegacyStaff();
    }

    match /products/{productId} {
      allow read, write: if isLegacyStaff();
    }

    match /inventory/{productId} {
      allow read: if isLegacyStaff();
      allow write: if isLegacyAdminOrVet();
    }

    match /inventario/{productId} {
      allow read: if isLegacyStaff();
      allow write: if isLegacyAdminOrVet();
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isLegacyAdminOrVet();
    }

    match /sales/{saleId} {
      allow read, write: if isLegacyStaff();
    }

    match /ventas/{saleId} {
      allow read, write: if isLegacyStaff();
    }

    match /medical_records/{recordId} {
      allow read, write: if isLegacyStaff();
    }

    match /clinical_records/{recordId} {
      allow read: if isSignedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || isLegacyStaff()
        );
      allow write: if isLegacyAdminOrVet();

      match /attachments/{fileId} {
        allow read, write: if isLegacyStaff();
      }
    }

    match /historial_clinico/{recordId} {
      allow read, write: if isLegacyStaff();
    }

    match /servicios_veterinarios/{serviceId} {
      allow read, write: if isLegacyStaff();
    }

    match /messages/{messageId} {
      allow read, write: if isSignedIn()
        && (
          resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
          || (resource.data.keys().hasAny(['participants'])
              && request.auth.uid in resource.data.participants)
          || isLegacyStaff()
        );
      allow create: if isSignedIn();
    }

    match /chats/{chatId} {
      allow read, write: if isSignedIn()
        && (
          (resource.data.keys().hasAny(['participants'])
            && request.auth.uid in resource.data.participants)
          || isLegacyStaff()
        );
      allow create: if isSignedIn();
    }

    match /mensajes/{messageId} {
      // FR-02: Chat fuera de Beta-1 / RC1 — deny total
      allow read, write: if false;
    }

    match /notifications/{notificationId} {
      allow read, update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow read, write: if isLegacyStaff();
    }

    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isLegacyAdminOrVet();
    }

    // ─── Deny everything else ─────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
