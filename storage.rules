rules_version = '2';

/**
 * NexoGo Storage rules — S0 Secure
 * Tenant files under companies/{companyId}/** require ACTIVE membership.
 * Paths outside tenant/legacy allow-lists are denied.
 */
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function membershipDoc(companyId) {
      return firestore.get(
        /databases/(default)/documents/companies/$(companyId)/memberships/$(request.auth.uid)
      );
    }

    function isCompanyMember(companyId) {
      return isSignedIn()
        && firestore.exists(
          /databases/(default)/documents/companies/$(companyId)/memberships/$(request.auth.uid)
        )
        && membershipDoc(companyId).data.status == 'ACTIVE';
    }

    function legacyRole() {
      return firestore.get(
        /databases/(default)/documents/usuarios/$(request.auth.uid)
      ).data.rol;
    }

    function isLegacyStaff() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && legacyRole() in ['ADMIN', 'VET', 'VET_ASSISTANT', 'ASSISTANT'];
    }

    function isLegacyAdminOrVet() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid))
        && legacyRole() in ['ADMIN', 'VET'];
    }

    // ─── Platform tenant storage ──────────────────────────────────────────

    match /companies/{companyId}/{allPaths=**} {
      allow read, write: if isCompanyMember(companyId);
    }

    // ─── Legacy allow-listed paths ────────────────────────────────────────

    match /users/{userId}/profile/{fileName} {
      allow read, write, delete: if isOwner(userId);
    }

    match /patients/{patientId}/images/{fileName} {
      allow read, write, delete: if isLegacyStaff();
    }

    match /medical_records/{recordId}/files/{fileName} {
      allow read: if isLegacyStaff();
      allow write, delete: if isLegacyAdminOrVet();
    }

    match /medical_records/{recordId}/pdfs/{fileName} {
      allow read: if isLegacyStaff();
      allow write: if isLegacyAdminOrVet();
    }

    match /medical_records/{recordId}/thumbs/{fileName} {
      allow read: if isLegacyStaff();
      allow write: if isLegacyAdminOrVet();
    }

    match /inventory/{productId}/{fileName} {
      allow read: if isLegacyStaff();
      allow write, delete: if isLegacyAdminOrVet();
    }

    match /chats/{chatId}/files/{fileName} {
      allow read, write, delete: if isLegacyStaff();
    }

    match /sales/{saleId}/documents/{fileName} {
      allow read, write, delete: if isLegacyStaff();
    }

    match /reports/{reportId}/files/{fileName} {
      allow read, write, delete: if isLegacyStaff();
    }

    match /temp/{userId}/{fileName} {
      allow read, write, delete: if isOwner(userId);
    }

    match /public/{fileName} {
      allow read: if isSignedIn();
      allow write, delete: if isLegacyAdminOrVet();
    }

    // ─── Deny everything else ─────────────────────────────────────────────

    match /{allPaths=**} {
      allow read, write, delete: if false;
    }
  }
}
